<?xml version="1.0"?>
<!--
soki_sim: r(半径方向), 根本θ(旋回), z(昇降), 手先θ(手先回転) の
4自由度円柱座標型アームの簡易モデル。
RVizでの見た目確認用途のため、慣性(inertial)や衝突形状(collision)は持たない。

関節構成 (base_link を基準に直列):
  base_link   =[root_theta_joint (continuous, z軸)]=>  turret_link (旋回台+マスト)
  turret_link =[z_joint (prismatic, z軸)]=>             lift_link (昇降キャリッジ)
  lift_link   =[r_joint (prismatic, x軸)]=>             arm_link (伸縮アーム)
  arm_link    =[tip_theta_joint (continuous, z軸)]=>    tip_link (手先)

z_joint/r_joint は実機ではmotor1/motor2の2モータによる差動機構で駆動される
(z = k(m1+m2), r = k(m1-m2))ため、URDF上にもmotor1_joint/motor2_jointを
インジケータ(turret_link横の小さなスライダー)として持たせている。
soki_sim/motor_mixer_node が /joint_states を見て、motor1/motor2側とz/r側の
どちらが操作されたかを判定し、双方向にミキシングして反対側を追従させる
(launch/display.launch.py 参照)。そのためjoint_state_publisher_guiでは
motor1_joint/motor2_jointのスライダーを直接動かしても、z_joint/r_jointの
スライダーを直接動かしても、両方が連動して動く。
-->
<robot name="soki_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 寸法パラメータ -->
  <xacro:property name="base_radius" value="0.15"/>
  <xacro:property name="base_height" value="0.06"/>

  <xacro:property name="mast_radius" value="0.035"/>
  <xacro:property name="mast_height" value="0.7"/>

  <xacro:property name="lift_size_xy" value="0.14"/>
  <xacro:property name="lift_size_z" value="0.08"/>
  <xacro:property name="z_lower" value="0.0"/>
  <xacro:property name="z_upper" value="0.55"/>

  <xacro:property name="arm_length" value="0.4"/>
  <xacro:property name="arm_size_yz" value="0.05"/>
  <xacro:property name="r_lower" value="${-arm_length / 2}"/>
  <xacro:property name="r_upper" value="${arm_length / 2}"/>

  <xacro:property name="tip_radius" value="0.03"/>
  <xacro:property name="tip_height" value="0.1"/>

  <!-- motor1/motor2: z_joint/r_jointを駆動する差動機構のインジケータ -->
  <!-- z = mix_k*(m1+m2), r = mix_k*(m1-m2) の関係上、m1/m2の可動域は
       m1,m2 = z +/- r の取り得る範囲(z_lower+r_lower 〜 z_upper+r_upper)に一致させる -->
  <xacro:property name="motor_indicator_radius" value="0.015"/>
  <xacro:property name="motor_indicator_height" value="0.06"/>
  <xacro:property name="motor_offset_y" value="0.08"/>
  <xacro:property name="motor_lower" value="${z_lower + r_lower}"/>
  <xacro:property name="motor_upper" value="${z_upper + r_upper}"/>

  <xacro:property name="joint_velocity" value="1.0"/>
  <xacro:property name="joint_effort" value="10.0"/>

  <!-- マテリアル -->
  <material name="base_grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="turret_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="lift_orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>
  <material name="arm_green">
    <color rgba="0.2 0.7 0.3 1.0"/>
  </material>
  <material name="tip_red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  <material name="motor_yellow">
    <color rgba="0.9 0.8 0.1 1.0"/>
  </material>

  <!-- base_link: 固定の台座 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="base_grey"/>
    </visual>
  </link>

  <!-- turret_link: 旋回台+マスト (root_theta_joint で旋回) -->
  <link name="turret_link">
    <visual>
      <origin xyz="0 0 ${mast_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${mast_radius}" length="${mast_height}"/>
      </geometry>
      <material name="turret_blue"/>
    </visual>
  </link>

  <joint name="root_theta_joint" type="continuous">
    <parent link="base_link"/>
    <child link="turret_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1"/>
    <limit effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- motor1_link/motor2_link: 差動機構の各モータ位置を示すインジケータ -->
  <!-- 実際の見た目(マスト昇降・アーム伸縮)を動かすのはz_joint/r_jointであり、
       motor1_joint/motor2_jointはturret_link横で上下するだけの表示専用リンク -->
  <link name="motor1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${motor_indicator_radius}" length="${motor_indicator_height}"/>
      </geometry>
      <material name="motor_yellow"/>
    </visual>
  </link>

  <joint name="motor1_joint" type="prismatic">
    <parent link="turret_link"/>
    <child link="motor1_link"/>
    <origin xyz="${mast_radius + 0.03} ${motor_offset_y} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${motor_lower}" upper="${motor_upper}" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <link name="motor2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${motor_indicator_radius}" length="${motor_indicator_height}"/>
      </geometry>
      <material name="motor_yellow"/>
    </visual>
  </link>

  <joint name="motor2_joint" type="prismatic">
    <parent link="turret_link"/>
    <child link="motor2_link"/>
    <origin xyz="${mast_radius + 0.03} ${-motor_offset_y} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${motor_lower}" upper="${motor_upper}" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- lift_link: マストに沿って昇降するキャリッジ (z_joint) -->
  <link name="lift_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${lift_size_xy} ${lift_size_xy} ${lift_size_z}"/>
      </geometry>
      <material name="lift_orange"/>
    </visual>
  </link>

  <joint name="z_joint" type="prismatic">
    <parent link="turret_link"/>
    <child link="lift_link"/>
    <origin xyz="0 0 ${lift_size_z / 2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${z_lower}" upper="${z_upper}" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- arm_link: キャリッジから水平に伸縮するアーム (r_joint) -->
  <!-- r_joint の原点(r=0)がアームの中心になるよう、visualはarm_link原点を中心に配置する -->
  <link name="arm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${arm_length} ${arm_size_yz} ${arm_size_yz}"/>
      </geometry>
      <material name="arm_green"/>
    </visual>
  </link>

  <joint name="r_joint" type="prismatic">
    <parent link="lift_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${r_lower}" upper="${r_upper}" effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

  <!-- tip_link: アーム先端で回転する手先 (tip_theta_joint) -->
  <link name="tip_link">
    <visual>
      <origin xyz="0 0 ${tip_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${tip_radius}" length="${tip_height}"/>
      </geometry>
      <material name="tip_red"/>
    </visual>
  </link>

  <joint name="tip_theta_joint" type="continuous">
    <parent link="arm_link"/>
    <child link="tip_link"/>
    <origin xyz="${arm_length / 2} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1"/>
    <limit effort="${joint_effort}" velocity="${joint_velocity}"/>
  </joint>

</robot>
