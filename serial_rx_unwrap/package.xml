<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>serial_rx_unwrap</name>
  <version>0.0.0</version>
  <description>
    ros2can の serial_rx_[DEVICE_ID] (Int16MultiArray, ±32768で折り返す生スロット)を
    購読し、全スロットをラップ検出して連続値化した serial_rx_[DEVICE_ID]_unwrapped
    (Int32MultiArray) として配信するブリッジノード。ros2can本体には手を入れず、
    独立したプロセスとしてunwrap処理を行う。
  </description>
  <maintainer email="tashikou1682@gmail.com">dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
